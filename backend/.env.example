# Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/meetsync

# Redis (optional in MVP; used for cache-aside on calendar reads)
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Encryption for tokens at rest (32 bytes hex = 64 chars)
ENCRYPTION_KEY=replace_with_64_char_hex_string

# Google OAuth (leave blank to use the built-in Mock Calendar Provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# Email (leave blank to use console-log email provider in dev)
SENDGRID_API_KEY=
EMAIL_FROM=noreply@meetsync.dev
